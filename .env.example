# Copy to .env. Never commit credentials. The current local .env is configured.
APP_URL=http://127.0.0.1:3000
# PostgreSQL application role, not a database superuser.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/my_kineshma
# Generate a unique random secret of at least 32 characters. No default is accepted.
BETTER_AUTH_SECRET=
UPLOAD_DIR=./storage/uploads

# Use the exact same APP_URL in your browser; do not alternate localhost/127.0.0.1.
# For public hosting APP_URL must use HTTPS. Keep PostgreSQL on a private interface.
# Upload limit is enforced in server code: 5 MiB, 20 megapixels, 6 images per post.
# Create administrators only with npm run admin:create; no public registration.
